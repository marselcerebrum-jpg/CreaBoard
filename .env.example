# Koneksi ke Postgres stack supabase-content (host "db" di jaringan Docker supabase-content_default).
DATABASE_URL=postgres://creaboard_app:GANTI_PASSWORD@db:5433/postgres
# Akun Leader Marketing pertama (hanya dipakai saat database masih kosong).
ADMIN_USERNAME=leader
ADMIN_NAME=Leader Marketing
ADMIN_PASSWORD=
# Unggah footage langsung ke folder Google Drive (opsional; tanpa ini file disimpan di server).
# Cara mudah: Apps Script (scripts/drive-upload.gs), file maks. ±35 MB.
GOOGLE_APPS_SCRIPT_URL=
GOOGLE_APPS_SCRIPT_SECRET=
# Atau OAuth (untuk file besar):
# Akun Google biasa: buat OAuth client "Desktop app", lalu jalankan scripts/google-auth.js untuk refresh token.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# Atau service account (khusus folder di Shared Drive): path file JSON kunci di dalam container.
# GOOGLE_SERVICE_ACCOUNT_FILE=
