# MySQL 8 (Cloud SQL lewat Auth Proxy di jaringan Docker), atau Postgres stack supabase-content.
# DATABASE_URL=mysql://creative_desk:GANTI_PASSWORD@cloudsql-proxy:3306/marsel_creative_desk
DATABASE_URL=postgres://creaboard_app:GANTI_PASSWORD@db:5433/postgres
# …atau isi terpisah (dipakai bila DATABASE_URL kosong); password boleh berkarakter khusus apa adanya.
# DB_CLIENT=mysql
# DB_HOST=10.0.0.5
# DB_PORT=3306
# DB_USER=creative_desk
# DB_PASSWORD=
# DB_NAME=marsel_creative_desk
# Akun Leader Marketing pertama (hanya dipakai saat database masih kosong).
ADMIN_USERNAME=leader
ADMIN_NAME=Leader Marketing
ADMIN_PASSWORD=
